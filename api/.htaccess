# API: všechny požadavky jdou na index.php (front controller).
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(src|migrations|bin|data|storage)/ - [F,L]
  RewriteRule ^config(\..+)?\.php$ - [F,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L,QSA]
</IfModule>

# Jistota: citlivé soubory nikdy neposílat ven, ani kdyby rewrite nefungoval.
<FilesMatch "^(config(\..+)?\.php|.*\.sql)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  # Výchozí je no-store; trasy, které si cachování řídí samy (fotky postav a mapy: private, max-age s ETag), ho nepřepíšou.
  Header always setifempty Cache-Control "no-store"
  # API vrací jen JSON a obrázky: nikdy skripty ani vložení do rámců.
  Header always set Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
  Header always set Cross-Origin-Resource-Policy "same-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/json
</IfModule>
