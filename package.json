{
  "name": "dnd",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dry": "node scripts/deploy.mjs --dry",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "db:start": "docker compose up -d --wait && php api/bin/migrate.php && php api/bin/seed.php",
    "db:stop": "docker compose stop",
    "db:migrate": "php api/bin/migrate.php",
    "db:reset": "php api/bin/migrate.php --fresh && php api/bin/seed.php",
    "api": "php -S 127.0.0.1:8080 -t api api/index.php",
    "test:api": "vitest run --config vitest.api.config.ts",
    "seed:hajos": "php api/bin/seed-hajos.php",
    "start": "concurrently -k -n api,web -c blue,green \"npm:api\" \"npm:dev\"",
    "test:all": "npm run typecheck && npm run lint && npm test && npm run test:api && npm run test:e2e",
    "db:seed": "php api/bin/seed.php"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@types/leaflet": "^1.9.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.53.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "basic-ftp": "^6.2.2",
    "concurrently": "^10.0.6",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
