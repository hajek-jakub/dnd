
# Seed postavy Hajoš (npm run seed:hajos). Soubor .env je v .gitignore.
# Přihlašovací jméno tvého účtu v aplikaci (aplikace nemá e-maily, přihlašuje se jménem a heslem).
SEED_OWNER_USERNAME=
# Volitelné: id kampaně (uuid z adresy /campaigns/<id>). Prázdné = založí se "Testovací kampaň (seed)".
SEED_CAMPAIGN_ID=
