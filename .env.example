# Veřejné proměnné (vkládají se do buildu, NIC TAJNÉHO sem nepatří).
# Zkopíruj do .env.development.local (lokální vývoj) nebo .env.production.local (ostrý build).
# Hodnoty pro lokální Supabase zjistíš příkazem:  npx supabase status

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=sem-vloz-anon-nebo-publishable-key

# Cesta, pod kterou aplikace běží. Pro kořen subdomény (dnd.hajekjakub.cz) nech /.
# Při nasazení do podsložky nastav např. /dnd/ (a uprav RewriteBase v public/.htaccess).
# VITE_BASE_PATH=/
