# FTP údaje pro "npm run deploy". Zkopíruj do .env.deploy (je v .gitignore, nikdy se necommituje).
FTP_HOST=ftp.hajekjakub.cz
FTP_USER=uzivatel@hajekjakub.cz
FTP_PASSWORD=tajne-heslo
# Složka subdomény na hostingu (zjistíš ji v administraci Endory nebo přes FTP klienta).
FTP_REMOTE_DIR=/dnd.hajekjakub.cz
# FTPS (šifrované spojení). Pokud server nepodporuje, nastav false.
FTP_SECURE=true
# Volitelně jiný port než 21:
# FTP_PORT=21
