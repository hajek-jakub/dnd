# FTP údaje pro "npm run deploy". Zkopíruj do .env.deploy (je v .gitignore, nikdy se necommituje).
FTP_HOST=ftp.hajekjakub.cz
# Doporučeno: samostatný FTP účet zamčený do složky aplikace (Endora: směrování na /_sub/dnd).
FTP_USER=dnd
FTP_PASSWORD=tajne-heslo
# Účet je zamčený přímo ve složce aplikace, takže jeho kořen je bezpečný.
FTP_JAILED=true
# (Bez zamčeného účtu místo toho nastav konkrétní složku, např. FTP_REMOTE_DIR=/_sub/dnd, a FTP_JAILED vynech.)
# Adresa hotové aplikace (deploy přes ni spustí migrace databáze).
SITE_URL=https://dnd.hajekjakub.cz
# FTPS (šifrované spojení). Pokud server nepodporuje, nastav false.
FTP_SECURE=true
# Volitelně jiný port než 21:
# FTP_PORT=21
