# D&D kampaně – statická SPA na Apache (Endora)
# Soubor se kopíruje z public/ do dist/ při buildu.

Options -Indexes
DirectoryIndex index.html

# Vynutit HTTPS (přihlášení a schránka fungují jen přes https).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^localhost
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # SPA routing: cokoli, co není existující soubor nebo složka, jde na index.html.
  # Pokud nasadíš do podsložky, změň RewriteBase (např. /dnd/) a odpovídající cestu níže.
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  # Chybějící soubory v /assets/ mají vrátit 404, ne index.html (jinak by se při zastaralé cache hlásily záhadné chyby).
  RewriteCond %{REQUEST_URI} !/assets/
  # /api/ obsluhuje PHP (api/.htaccess), nikdy ne index.html.
  RewriteCond %{REQUEST_URI} !^/api(/|$)
  RewriteRule . /index.html [L]
</IfModule>

# Bezpečnostní hlavičky
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Content Security Policy: skripty jen z vlastní domény plus jediný vložený skript (nastavení tmavého režimu před vykreslením),
  # povolený podle otisku. Změníš-li ho v index.html, musíš přepsat sha256 tady (hlídá to src/test/csp.test.ts).
  # Styly smí být vložené (Leaflet a toasty je potřebují), obrázky z API a data:/blob:, spojení jen na vlastní doménu.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-34vXusKkAuzjwCRWKileslx5VQ0stt1o38GiujHcAXg='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>

# Komprese
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>

# Cachování: assety ve /assets/ mají hash v názvu, takže mohou být cachované na rok.
# index.html se nikdy necachuje, aby se po nasazení hned načetla nová verze.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(?:index\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
